;; Shapes: how many arguments each atom and constructor takes, and whether
;; a literal or a constructor fits the column it is written in.
union (expr (num int) (add expr expr))
union (shape (circle int))
struct (point int int)
lattice (cost (min int))
table (edge int int)
table (prog expr)
table (label int str)
table (dist int cost)
table (seen int)
demand (double int) int
rule (edge 1 2) (prog (num 1)) (label 1 "one") (dist 1 3)
rule (double N (* 2 N))

rule (edge X Y) --> (edge X Y X)                 ;; expect arity edge
rule (edge X Y) --> (prog (add (num X)))         ;; expect singleton Y, arity add
rule (edge X Y) --> (prog (num (double X Y)))    ;; expect arity double
rule (edge X Y) --> (edge X (double Y))
rule (edge X _) ~(dist X) --> (seen X)           ;; a lattice is negated by its key
rule (edge X _) --> (label X 7)                  ;; expect type 7
rule (edge _ _) --> (label "x" "y")              ;; expect type "x"
rule (edge X _) --> (prog (circle X))            ;; expect type circle
rule (edge X _) --> (prog (point X X))           ;; expect type point
rule (edge X _) --> (prog (add (num X) (num 2)))
rule (edge X _) --> (dist X 4)
