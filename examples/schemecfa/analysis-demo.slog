;; Demonstrates the analysis.slog query layer over three call-graph
;; shapes: a monomorphic higher-order call (twice), a genuinely
;; polymorphic operator (an unknown-condition pick), and primitive sites.

include "analysis.slog"

rule (mlimit 1)

;; twice applies f at two sites; the argument closure is the only callee
;; at each, so both are monomorphic and (m=1) inlinable.
rule
(program
 (let "twice"
   (lambda ["f" "x"] (app (ref "f") [(app (ref "f") [(ref "x")])]))
   (app (ref "twice")
        [(lambda ["y"] (app (ref "+") [(ref "y") (num 1)])) (num 5)])))

;; pick returns one of two lambdas under an UNKNOWN condition ((< 1 2)
;; abstracts to both booleans), so both flow to `chosen`; the single
;; call site (chosen 7) is polymorphic -- two target lambdas.
rule
(program
 (let "inc" (lambda ["p"] (app (ref "+") [(ref "p") (num 1)]))
   (let "dec" (lambda ["q"] (app (ref "-") [(ref "q") (num 1)]))
     (let "pick" (lambda ["c" "t" "e"] (if (ref "c") (ref "t") (ref "e")))
       (let "chosen" (app (ref "pick")
                          [(app (ref "<") [(num 1) (num 2)]) (ref "inc") (ref "dec")])
         (app (ref "chosen") [(num 7)]))))))
