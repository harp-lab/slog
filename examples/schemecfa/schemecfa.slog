;; m-CFA with abstract counting for a nine-form Scheme.
;; The context depth is data: edit (mlimit 2) and rerun.

include "counting.slog"

rule (mlimit 2)

;; P1 -- factorial.  Comparisons on the abstract number answer both
;; ways, so the recursion runs forever abstractly; m = 2 keeps the top
;; two unwindings' frames unique (unique_binding on n there), then the
;; self-loop frame [rec rec] goes to inf (summarized_binding).
rule
(program
 (letrec "fac"
   (lambda ["n"]
     (if (app (ref "=") [(ref "n") (num 0)])
         (num 1)
         (app (ref "*") [(ref "n")
                         (app (ref "fac")
                              [(app (ref "-") [(ref "n") (num 1)])])])))
   (app (ref "fac") [(num 6)])))

;; P2 -- two-parameter higher-order call: twice applies its argument
;; closure at two distinct sites, so each site is its own frame and
;; every binding in the program stays unique.
rule
(program
 (let "twice"
   (lambda ["f" "x"] (app (ref "f") [(app (ref "f") [(ref "x")])]))
   (app (ref "twice")
        [(lambda ["y"] (app (ref "+") [(ref "y") (num 1)])) (num 5)])))

;; P3 -- primitives are first-class values: call2 receives + at one
;; site and < at another, so context separates its two frames and g is
;; a must_value in each (+ here, < there).  The comparison result r2 is
;; the program's one polyvariant_flow address (< yields both booleans),
;; yet it is still a unique_binding.  eq? of a number and a boolean is
;; precisely false.
rule
(program
 (let "call2"
   (lambda ["g" "a" "b"] (app (ref "g") [(ref "a") (ref "b")]))
   (let "r1" (app (ref "call2") [(ref "+") (num 10) (num 20)])
     (let "r2" (app (ref "call2") [(ref "<") (num 1) (num 2)])
       (app (ref "eq?") [(ref "r1") (ref "r2")])))))

;; P4 -- the depth-2 dividend: both calls of wrap route through the one
;; app inside it; m = 2 still separates id's frames, so each symbol
;; stays a must_value and the eq? is precisely false.  With (mlimit 1)
;; the two flows merge and the result blurs to both booleans.
rule
(program
 (let "id" (lambda ["z"] (ref "z"))
   (let "wrap" (lambda ["w"] (app (ref "id") [(ref "w")]))
     (let "s1" (app (ref "wrap") [(sym "one")])
       (let "s2" (app (ref "wrap") [(sym "two")])
         (app (ref "eq?") [(ref "s1") (ref "s2")]))))))

;; P5 -- branch sensitivity: the test is decided, so the dead branch
;; never shows up in reachable_expr.
rule
(program
 (if (app (ref "not") [(boolean (ff))])
     (sym "live")
     (sym "dead")))

;; P6 -- closure allocation under recursion: the escaping lambda is
;; born in three abstract frames; the first two are unique concrete
;; objects (unique_closure), the self-loop frame's is summarized.
rule
(program
 (letrec "loop"
   (lambda ["i"]
     (if (app (ref "=") [(ref "i") (num 0)])
         (lambda ["k"] (ref "k"))
         (app (ref "loop") [(app (ref "-") [(ref "i") (num 1)])])))
   (app (ref "loop") [(num 3)])))
