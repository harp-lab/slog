config/config.slog
config/system.slog
config/*.tmp
config/cache/
*/compiled/*
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md
slogd
*.o
*.so
*.zo
*.dep
.DS_Store
*.nix
.history/
.vscode/
slog-freeze
/slog
