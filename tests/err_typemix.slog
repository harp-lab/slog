;; Runtime error: an any-typed value of the wrong kind flowing into a prim
;; (here str + int) produces (error (type_mismatch ...)) instead of aborting;
;; the well-typed row (21+1) still fires.
table (thing any)
table (incremented int)
rule
(thing 21)
(thing "oops")
rule (thing X) (= Y (+ X 1)) --> (incremented Y)
