;; Merge-differential fixture B: same decls as mergea; overlapping fact
;; (seed 2 20) checks struct/row dedup, (seed 3 5) checks the per-key
;; lattice join against A's (seed 3 30), (seed 4 40) is disjoint growth.

union (pr (mk int int))
table (t str pr cmap)
lattice (low (min int))
table (d int low)
lattice (iset (set int))
table (r int iset)
table (seed int int)

rule (seed 2 20) (seed 3 5) (seed 4 40)

rule (seed a b) (= m (cput (cmap) "k" a)) --> (t "X" (mk a b) m)
rule (seed a b) --> (d a b)
rule (seed a b) (= s (cins (cins (cmap) a) b)) --> (r 7 s)

;; sequences: the fifth remapped id space (docs/sequences.md §8.4) --
;; string elements force remap, nesting forces child-first rebuild,
;; the shared row checks cross-db dedup after re-chunking
table (q (list any))
rule (seed a b) --> (q ["s" a [b] []])

;; rope strings: the tag-4 arm of the import remap (materialize + rebuild
;; in the dest arena; the shared seed row dedups across databases)
table (q2 str)
rule (seed a b)
     (= p "0123456789012345678901234567890123456789012345678901234567890123")
     (= s (+ (+ (+ p p) (+ p p)) (i2s a)))
 --> (q2 s)

;; bignum (mpz) values: the value.mpz remapped id space (docs/primitives.md
;; §14).  (* <30-digit literal> a) interns a distinct GMP mpz per key, so an
;; import must re-intern + REMAP each mpz word into the dest interner; shared
;; seed keys dedup the value across databases, disjoint keys grow it.  The
;; merge-differential diff (api-tests.sh §8) then covers mpz remap for free.
table (bigv int int)
rule (seed a b) (= v (* 123456789012345678901234567890 a)) --> (bigv a v)

;; demand relation: the demand transform's interned key-structs (dsq n) and
;; answer table (dsq_ans) are a further struct-id space the import must remap;
;; shared seed keys dedup the demanded struct + answer, disjoint keys grow it.
demand (dsq int) int
rule (dsq n r) <-- (= r (* n n))
table (dsqres int int)
rule (seed a b) (dsq a r) --> (dsqres a r)
