;; accel sidecar x lattices (§4.4 v2 tier 3): min-int distances relax
;; down a 150-node weighted chain (~150 rounds) -- compressed saves record
;; lattice key rows, dedup by key at save, and merge-ingest on replay.
lattice (cost (min int #:floor 0))
table (edge int int int)
table (dist int cost)

rule (dist 1 0)
rule (dist X D) (edge X Y W) --> (dist Y (+ D W))

