;; M6L boundary, retired by M7 sub-slice (b): the acyclic producer keeps
;; its M6L fold; the recursive table consumer takes the M4T sweep driven
;; by the staged replacement rows.

lattice (cost (min int))

table (offer int int)
table (best int cost)
table (reported int int)

rule (offer K V) --> (best K V)
rule (best K V) --> (reported K V)
rule (reported K V) --> (reported K V)
