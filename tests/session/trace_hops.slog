;; Execution-trace sampling fixture (docs/pausing.md §15): reachability
;; over a 24-node graph, with each reached pair a STRUCT, so the bottom-k
;; samples must hash struct content rather than intern ids (which follow
;; session history and, in general, thread order).  Deltas run to ~200 rows, far past
;; the default sample of 8.
struct (hop int int)
table (edge int int)
table (reach hop)

rule (edge X Y) --> (reach (hop X Y))
rule (reach (hop X Y)) (edge Y Z) --> (reach (hop X Z))

rule
(edge 0 1)
(edge 0 5)
(edge 1 4)
(edge 1 6)
(edge 2 7)
(edge 3 8)
(edge 3 10)
