;; M6L boundary, retired by M7 sub-slice (b): the recursive lattice head
;; repairs via stored contributors (the self-loop's rec support drains by
;; absorption; the deletion regresses to the retained loser).

lattice (cost (min int))

table (offer int int)
table (best int cost)

rule (offer K V) --> (best K V)
rule (best K V) --> (best K V)
