;; dem_map in bracket clothing: the map judgment written with list
;; literals and tail patterns instead of explicit cons/nil -- exercising
;; the desugar inside demand-judgment heads, bodies, and pattern-facts.

union (clo (addk int) (dbl))

demand (apply clo int) int
rule (apply (addk k) n r) <-- (= r (+ n k))
rule (apply (dbl) n r) <-- (= r (+ n n))

demand (map clo list) list
facts (map f [] [])
rule (map f [x xs ...] [y ys ...]) <-- (apply f x y) (map f xs ys)

table (input list)
table (bumped list)
table (doubled list)
facts (input [1 2 3])

rule (input l) (map (addk 10) l r) --> (bumped r)
rule (input l) (map (dbl) l r) --> (doubled r)
