;; Cross-stratum use of a closed lattice relation: once dist's SCC is done
;; its values are final and unrestricted -- extracted into plain columns,
;; used as probe keys, compared, tested for equality.  Also exercises a
;; secondary payload-map ordering (the hub join probes dist on its first
;; key) and re-merging across the between-strata reload.

lattice (cost (min int #:floor 0))
table (edge int int int)
table (dist int int cost)
table (hub int)
table (hubdist int int)
table (to4 int int)
table (cheap int int)

rule
(edge 1 2 10) (edge 2 3 5) (edge 3 1 2)
(edge 1 3 100) (edge 3 4 1) (edge 2 4 20)
(edge 1 4 17)
(hub 2)

rule (edge X Y W) --> (dist X Y W)
rule (dist X Y D) (edge Y Z W) --> (dist X Z (+ D W))

;; later stratum: dist is closed here
rule (hub H) (dist H Y D) --> (hubdist Y D)
rule (dist X 4 D) --> (to4 X D)
rule (dist X Y D) (< D 6) --> (cheap X Y)
