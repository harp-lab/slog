;; Guard scheduling: guards textually before the join that binds them,
;; between two joins (referencing a variable bound only by the later join),
;; after all joins, and a comparison against a computed value.

table (e int int)
table (f int int)
table (pq int int)

table (g3 int int int)   ;; (< X 3) before joins; (> Z Y) before f binds Z
table (h int int)        ;; guard after both joins
table (cmpcalc int int)  ;; Y < X*X

facts
(e 1 2)
(e 2 3)
(e 3 4)
(e 4 1)

(f 2 5)
(f 3 1)
(f 4 9)
(f 1 7)

(pq 1 5)
(pq 2 3)
(pq 3 8)
(pq 4 20)

rule (< X 3) (e X Y) (> Z Y) (f Y Z) --> (g3 X Y Z)
rule (e X Y) (f Y Z) (>= X 2) --> (h X Z)
rule (pq X Y) (= T (* X X)) (< Y T) --> (cmpcalc X Y)
