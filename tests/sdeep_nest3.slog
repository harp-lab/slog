;; 3-level nested struct construction in ground AND derived rule heads,
;; plus 2- and 3-level destructuring in bodies.

struct (leaf int)
struct (mid leaf int)
struct (wrap mid int)

table (src int int int)
table (built wrap)
table (given wrap)
table (getx int)
table (getg int int int)
table (getm mid)

rule
(src 1 2 3)
(src 4 5 6)
(given (wrap (mid (leaf 7) 8) 9))

rule (src X Y Z) --> (built (wrap (mid (leaf X) Y) Z))

;; 3-level destructuring with wildcards
rule (built (wrap (mid (leaf X) _) _)) --> (getx X)

;; full 3-level destructuring of a fact-constructed struct
rule (given (wrap (mid (leaf A) B) C)) --> (getg A B C)

;; 1-level destructuring pulling out the middle struct
rule (given (wrap M _)) --> (getm M)
