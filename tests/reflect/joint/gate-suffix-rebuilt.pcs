;; RF5-B gate: a suffix batch anchored on a REBUILT relation cannot map --
;; its anchor version does not survive the replacement, so the v1
;; admission refuses typed (historical-program-replacement) rather than
;; guessing a correspondence (rf5 §8).
(program-change-set (abi 1)
  (base (program "p1:layer-base:0") (boundary "b1:layer-base:0"))
  (candidate (image "sha-gate-suffix-refuse") (compiler "fprint-test") (plan-abi 2) (sources))
  (occurrences (replace (old "m1:p1:layer-base:0:root") (new-slot ()) (home ())))
  (rule-lineage)
  (slot-lineage ((relation edge) (old "v1:layer-base:0:0") (disposition carry))
                ((relation path) (old "v1:layer-base:0:1") (disposition rebuild)))
  (diffs) (writers (old (path)) (new (path)))
  (sccs (old ()) (new ()))
  (affected (roots (path)) (cone (path)))
  (services)
  (suffix (batch path (v 1) ((+ 7 8)) ()))
  (refusals))
