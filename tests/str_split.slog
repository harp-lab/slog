;; ssplit/sjoin bridge strings and [str] lists (docs/sequences.md §6);
;; s2i/s2f are PARTIAL (MALFORMED input = no row), i2s/f2s total.  Since
;; exact ints (docs/primitives.md §14), s2i's magnitude is unbounded:
;; "9999999999" parses to a bignum; only format errors abandon.

table (csv str)
table (fields (list str))
table (rejoined str)
table (roundtrip int)
table (chars (list str))
table (nums str int)
table (fls str float)
table (render int str)

rule (csv "alpha,beta,,delta")

rule (csv s) --> (fields (ssplit s ","))
rule (csv s) (fields f) --> (rejoined (sjoin f ","))
rule (csv s) (rejoined s) --> (roundtrip 1)      ;; join . split = id

;; empty separator: per-codepoint split
rule (csv _) --> (chars (ssplit "a€b" ""))

;; parses: hits produce rows, misses produce NOTHING (partiality)
table (cand str)
rule (cand "42") (cand "-7") (cand "9999999999") (cand "12x") (cand "")
rule (cand s) (= n (s2i s)) --> (nums s n)
table (fcand str)
rule (fcand "2.5") (fcand "-0.125") (fcand "1e3") (fcand "no")
rule (fcand s) (= x (s2f s)) --> (fls s x)

rule (csv _) --> (render 1 (i2s -13))
rule (csv _) --> (render 2 (f2s 2.5))
rule (csv _) --> (render 3 (f2s 4.0))
