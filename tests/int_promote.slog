;; Exact-integer promotion/contraction at the s32 boundary (docs/primitives.md
;; §14): arithmetic never wraps -- a result outside [-2^31, 2^31) promotes to
;; an interned bignum, and a bignum result that shrinks contracts back to the
;; s32 word (so it joins ordinary s32 facts, proving canonicity).
;; Every expected row hand-computed.

table (maxi int)

table (padd int)     ;; 2147483648
table (pmul int)     ;; 4294967294
table (psub int)     ;; -2147483649
table (ppow int)     ;; 1099511627776 = 2^40
table (pshl int)     ;; 1099511627776
table (pshr int)     ;; 1 (shifted back down, contracts)
table (pdiv int)     ;; 2147483648 (INT_MIN / -1 now promotes, no error)
table (pabs int)     ;; 2147483648
table (pband int)    ;; 0   (mixed bignum/s32 bitwise)
table (pbor int)     ;; 1099511627781
table (pmin int)     ;; 2147483647 (mixed compare picks the s32)
table (pmax int)     ;; 2147483648
table (bigger int)   ;; guard straddling the boundary
table (roundtrip int) ;; contraction rejoins the seed fact

facts
(maxi 2147483647)

rule (maxi M) (= R (+ M 1)) --> (padd R)
rule (maxi M) (= R (* M 2)) --> (pmul R)
rule (maxi M) (= R (- (neg M) 2)) --> (psub R)
rule (maxi M) (= R (pow 2 40)) --> (ppow R)
rule (maxi M) (= R (shl 1 40)) --> (pshl R)
rule (maxi M) (= B (shl 1 40)) (= R (shr B 40)) --> (pshr R)

;; INT_MIN derived: -(2^31) contracts to the s32 word; dividing by -1
;; promotes to 2^31 (the retired ERR_INT_OVF case)
rule (maxi M) (= IM (neg (+ M 1))) (= R (/ IM -1)) --> (pdiv R)
rule (maxi M) (= IM (neg (+ M 1))) (= R (abs IM)) --> (pabs R)

rule (maxi M) (= B (shl 1 40)) (= R (band B 255)) --> (pband R)
rule (maxi M) (= B (shl 1 40)) (= R (bor B 5)) --> (pbor R)
rule (maxi M) (= B (+ M 1)) (= R (min B M)) --> (pmin R)
rule (maxi M) (= B (+ M 1)) (= R (max B M)) --> (pmax R)

rule (maxi M) (= B (+ M 1)) (> B M) --> (bigger B)

;; up past the boundary and back: the contracted word must JOIN (maxi C)
rule (maxi M) (= B (+ M 1)) (= C (- B 1)) (maxi C) --> (roundtrip C)
