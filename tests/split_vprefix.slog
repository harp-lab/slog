;; Regression: a `v_`-prefixed relation inside a stratum large enough to
;; split into multiple translation units.  canonicalize-vrefs (emit-cpp.rkt)
;; used to renumber the string literal "v_x" independently per TU, so the
;; spine addRelation'd one name while a cluster getRelation'd another =>
;; null Relation* => daemon segfault binding the read task's index at
;; stratum load.  This program must reach a fixpoint (every relation = {7}).
;; See docs/bug-daemon-crash-shape-car.md.
table (v_x int)
table (a0 int)
table (a1 int)
table (a2 int)
table (a3 int)
table (a4 int)
table (a5 int)
table (a6 int)
table (a7 int)
table (a8 int)
table (a9 int)
table (a10 int)
table (a11 int)
table (a12 int)
table (a13 int)
table (a14 int)
table (a15 int)
table (a16 int)
table (a17 int)
table (a18 int)
table (a19 int)
table (a20 int)
table (a21 int)
table (a22 int)
table (a23 int)
table (a24 int)
table (a25 int)
table (a26 int)
table (a27 int)
table (a28 int)
table (a29 int)
table (a30 int)
table (a31 int)
table (a32 int)
table (a33 int)
table (a34 int)
table (a35 int)
table (a36 int)
table (a37 int)
table (a38 int)
table (a39 int)
table (a40 int)
table (a41 int)
table (a42 int)
table (a43 int)
table (a44 int)
table (a45 int)
table (a46 int)
table (a47 int)
table (a48 int)
table (a49 int)
table (a50 int)
rule (a0 7)
rule (a0 X) <-- (a1 X)
rule (a1 X) <-- (a2 X)
rule (a2 X) <-- (a3 X)
rule (a3 X) <-- (a4 X)
rule (a4 X) <-- (a5 X)
rule (a5 X) <-- (a6 X)
rule (a6 X) <-- (a7 X)
rule (a7 X) <-- (a8 X)
rule (a8 X) <-- (a9 X)
rule (a9 X) <-- (a10 X)
rule (a10 X) <-- (a11 X)
rule (a11 X) <-- (a12 X)
rule (a12 X) <-- (a13 X)
rule (a13 X) <-- (a14 X)
rule (a14 X) <-- (a15 X)
rule (a15 X) <-- (a16 X)
rule (a16 X) <-- (a17 X)
rule (a17 X) <-- (a18 X)
rule (a18 X) <-- (a19 X)
rule (a19 X) <-- (a20 X)
rule (a20 X) <-- (a21 X)
rule (a21 X) <-- (a22 X)
rule (a22 X) <-- (a23 X)
rule (a23 X) <-- (a24 X)
rule (a24 X) <-- (a25 X)
rule (a25 X) <-- (a26 X)
rule (a26 X) <-- (a27 X)
rule (a27 X) <-- (a28 X)
rule (a28 X) <-- (a29 X)
rule (a29 X) <-- (a30 X)
rule (a30 X) <-- (a31 X)
rule (a31 X) <-- (a32 X)
rule (a32 X) <-- (a33 X)
rule (a33 X) <-- (a34 X)
rule (a34 X) <-- (a35 X)
rule (a35 X) <-- (a36 X)
rule (a36 X) <-- (a37 X)
rule (a37 X) <-- (a38 X)
rule (a38 X) <-- (a39 X)
rule (a39 X) <-- (a40 X)
rule (a40 X) <-- (a41 X)
rule (a41 X) <-- (a42 X)
rule (a42 X) <-- (a43 X)
rule (a43 X) <-- (a44 X)
rule (a44 X) <-- (a45 X)
rule (a45 X) <-- (a46 X)
rule (a46 X) <-- (a47 X)
rule (a47 X) <-- (a48 X)
rule (a48 X) <-- (a49 X)
rule (a49 X) <-- (a50 X)
rule (a50 X) <-- (v_x X)
rule (v_x X)   <-- (a0 X)
