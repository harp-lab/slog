;; walk to both corner leaves through the frozen rows
table (lm T)
rule (lm t0) <-- (t t0)
rule (lm l) <-- (lm (Nd l _))
table (rm T)
rule (rm t0) <-- (t t0)
rule (rm r) <-- (rm (Nd _ r))
table (corners int int)
rule (corners a b) <-- (lm (Lf a)) (rm (Lf b))
