;; The minimal change set: one root program, one rule edited in place.
;; edge survives (carry); path rebuilds from the base input boundary.
(program-change-set (abi 1)
  (base (program "p1:layer-base:0") (boundary "b1:layer-base:0"))
  (candidate (image "sha-minimal-v2") (compiler "fprint-test") (plan-abi 2)
             (sources ((path "minimal.slog") (text "table (edge int int)\ntable (path int int)\nrule (edge X Y) --> (path X Y)\nrule (path X Y) (edge Y Z) --> (path X Z)\n"))))
  (occurrences (replace (old "m1:p1:layer-base:0:root") (new-slot ()) (home ())))
  (rule-lineage ((old "r1:m1:p1:layer-base:0:root:0.0") (new-slot "0.0"))
                ((old "r1:m1:p1:layer-base:0:root:0.1") (new-slot "0.1"))
                ((old #f) (new-slot "0.2")))
  (slot-lineage ((relation edge) (old "v1:layer-base:0:0") (disposition carry))
                ((relation path) (old "v1:layer-base:0:1") (disposition rebuild)))
  (diffs (source 1) (semantic (added 1) (removed 0) (moved 0)) (plan (kernels-changed 1)))
  (writers (old (path)) (new (path)))
  (sccs (old ((scc 0 0 (members edge)) (scc 1 1 (members path))))
        (new ((scc 0 0 (members edge)) (scc 1 1 (members path)))))
  (affected (roots (path)) (cone (path)))
  (services)
  (suffix)
  (refusals))
