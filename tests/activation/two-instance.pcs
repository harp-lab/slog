;; The RF5-B gate's shape: a two-instance program replacing exactly ONE
;; instance (right); left's writers carry, right's rebuild.
(program-change-set (abi 1)
  (base (program "p1:layer-base:0") (boundary "b1:layer-base:0"))
  (candidate (image "sha-right-v2") (compiler "fprint-test") (plan-abi 2)
             (sources ((path "n1_graph_lib_v2.slog") (text "..."))))
  (occurrences (replace (old "m1:p1:layer-base:0:1") (new-slot ((1 "right"))) (home ((1 "right")))))
  (rule-lineage ((old "r1:m1:p1:layer-base:0:1:0.0") (new-slot "0.0"))
                ((old "r1:m1:p1:layer-base:0:1:0.1") (new-slot "0.1")))
  (slot-lineage ((relation left.edge) (old "v1:layer-base:0:0") (disposition carry))
                ((relation left.path) (old "v1:layer-base:0:1") (disposition carry))
                ((relation right.edge) (old "v1:layer-base:0:2") (disposition rebuild))
                ((relation right.path) (old "v1:layer-base:0:3") (disposition rebuild))
                ((relation answer) (old "v1:layer-base:0:4") (disposition rebuild)))
  (diffs (source 1) (semantic (added 1) (removed 1) (moved 0)) (plan (kernels-changed 1)))
  (writers (old (right.edge right.path answer)) (new (right.edge right.path answer)))
  (sccs (old ()) (new ((scc 0 0 (members right.edge)) (scc 1 1 (members right.path)) (scc 2 2 (members answer)))))
  (affected (roots (right.edge)) (cone (right.edge right.path answer)))
  (services)
  (suffix)
  (refusals))
