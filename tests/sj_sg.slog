;; Semijoin-filter correctness under recursion: same-generation on a small
;; tree.  In the delta-sg-driven version the filter checks "does PY have
;; children?" before expanding PX's children -- leaves must be pruned
;; without losing any same-generation pairs.
;;
;;        1
;;       / \
;;      2   3
;;     / \   \
;;    4   5   6
;;    |       |
;;    7       8
;;
;;   generation 1: (2,3) (3,2)
;;   generation 2: (4,5) (5,4) (4,6) (6,4) (5,6) (6,5)
;;   generation 3: (7,8) (8,7)
;;   plus the reflexive pairs (x,x) for every non-root node, since the base
;;   rule allows X = Y (both drawn from the same parent's children)

table (edge int int)
table (sg int int)

rule
(edge 1 2) (edge 1 3) (edge 2 4) (edge 2 5) (edge 3 6)
(edge 4 7) (edge 6 8)

rule (edge P X) (edge P Y) --> (sg X Y)
rule (edge PX X) (sg PX PY) (edge PY Y) --> (sg X Y)
