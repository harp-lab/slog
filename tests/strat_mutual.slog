;; Mutual recursion across three relations: a single SCC {m0,m1,m2}
;; must be solved as one fixpoint, cycling values m0 -> m1 -> m2 -> m0,
;; bounded by (< N 10).

table (m0 int)
table (m1 int)
table (m2 int)

rule
(m0 0)

rule (m0 N) (< N 10) (= M (+ N 1)) --> (m1 M)
rule (m1 N) (< N 10) (= M (+ N 1)) --> (m2 M)
rule (m2 N) (< N 10) (= M (+ N 1)) --> (m0 M)
