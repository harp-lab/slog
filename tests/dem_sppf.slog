;; Struct-valued answer columns and ambiguity: parse trees come back as
;; interned structs, so shared subtrees are stored once -- a packed parse
;; forest.  Grammar S -> S S | "a" over input "aaa" gives two trees for
;; the full span (left- and right-nested) sharing their leaves.

struct (leaf int)
struct (node tree tree)
union (tree leaf node)

demand (parse2 int) int tree
table (tok2 int str)
facts (tok2 0 "a") (tok2 1 "a") (tok2 2 "a")

rule (parse2 i (+ i 1) (leaf i)) <-- (tok2 i "a")
rule (parse2 i k (node t1 t2)) <-- (parse2 i j t1) (parse2 j k t2)

facts (parse2 0)
table (full tree)
rule (parse2 0 3 t) --> (full t)
