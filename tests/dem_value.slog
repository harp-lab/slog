;; Value-position calls: a demand-arity occurrence nested in an argument
;; denotes the answer.  Calls compose in = bindings (exactly like
;; primitive computations), guard arguments, constructor arguments, and
;; the answer position of a judgment's own head -- one-rule fib.

demand (sq int) int
rule (sq n (* n n))     ;; a judgment fact: the gate binds n

demand (fib int) int
rule (fib n n) <-- (< n 2)
rule (fib n (+ (fib (- n 1)) (fib (- n 2)))) <-- (< 1 n)

table (n int)
rule (n 4) (n 9)

;; composition through an = binding: r = sq(fib(x))
table (sqfib int int)
rule (n x) (= r (sq (fib x))) --> (sqfib x r)

;; a call in a guard argument
table (smallfib int)
rule (n x) (< (fib x) 10) --> (smallfib x)

;; a call in a constructor argument in a head
struct (pairv int int)
table (packed pairv)
rule (n x) --> (packed (pairv x (sq x)))
