;; Slog default configuration (TRACKED -- do not edit this file).
;;
;; This is an ordinary Slog program.  The front end injects the detected system
;; facts as config/system.slog (regenerated each run) and this program DERIVES
;; the settings database the compiler reads.  The compiler runs it once and
;; caches the result under config/cache/<hash>/, recomputing only when the
;; config files or the detected system change.
;;
;; To change settings, DO NOT edit this file: copy it to config/config.slog and
;; edit that (config.slog is gitignored and, if present, overrides this file).
;; See config/Config.md.  Any explicit command-line flag or SLOG_* environment
;; variable still overrides whatever the config computes.
;;
;; Note: setting NAMES and string VALUES must not contain spaces (the settings
;; are read back from space-separated CSV).

include "system.slog"

;; --- the settings database consumed by the front end ---------------------
;; setting_int:  numeric settings (threads, build_jobs, budgets)
;; setting_str:  string/enum settings (opt mode, memory cap)
table (setting_int str int)
table (setting_str str str)

;; User overrides, populated in config.slog; a matching name here takes
;; precedence over the default computed below.  Empty = accept the defaults.
table (override_int str int)
table (override_str str str)

;; --- worker threads ------------------------------------------------------
;; One fewer than the machine's cores (min 1), leaving headroom for the OS and
;; the compiler's own parallel build pool.
rule (sys_cores N) (> N 1) (= T (- N 1)) --> (setting_int "threads" T)
rule (sys_cores N) (<= N 1)              --> (setting_int "threads" 1)

;; --- parallel clang build jobs ------------------------------------------
;; The full core count (compilation overlaps the daemon's execution).
rule (sys_cores N) --> (setting_int "build_jobs" N)

;; --- optimization mode ---------------------------------------------------
;; "tiered" = fast -O0 first run + background -O2 hot-swap; "0" = -O0 only;
;; "2" = -O2 only.
facts (setting_str "opt" "tiered")

;; --- fixpoint pause budgets (ms) and memory cap -------------------------
facts
(setting_int "max_ms" 8000)
(setting_int "slice_ms" 500)
(setting_str "mem_max" "4G")
